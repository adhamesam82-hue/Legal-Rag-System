# One origin for both services. Every FastAPI route already lives under /api
# and Next.js claims nothing there, so no path rewriting is needed -- and
# because the browser never makes a cross-origin call, the CORS allowlist in
# src/legalrag/config.py stops mattering in production.

alsigil.com {
	encode zstd gzip

	# Once a browser has seen this header it refuses plaintext for a year, so a
	# lawyer typing "alsigil.com" on hotel wifi never makes the http:// request
	# that Caddy's redirect would otherwise have to answer -- and that request
	# is the one an attacker on the same network can intercept.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# Rate limiting is NOT here. It is not in Caddy's standard build -- it needs
	# the caddy-ratelimit plugin and a custom xcaddy image -- and what that buys
	# is a per-IP ceiling. Since T-001 every paid route is authenticated, so the
	# ceiling belongs on the caller instead: one office NAT is many lawyers, and
	# one abusive account is one subject however many addresses it dials from.
	# See src/legalrag/ratelimit.py.
	handle /api/* {
		# lb_try_duration makes Caddy hold and retry while the API container
		# restarts during a deploy, instead of returning 502. Not zero-downtime
		# -- it converts a visible error into one slow request.
		reverse_proxy api:8000 {
			lb_try_duration 15s
			lb_try_interval 500ms
			# Streaming answers (/api/ask/stream) must not be buffered.
			flush_interval -1
		}
	}

	handle {
		reverse_proxy web:3000 {
			lb_try_duration 15s
			lb_try_interval 500ms
		}
	}

	log {
		output stdout
		format console
	}
}

www.alsigil.com {
	redir https://alsigil.com{uri} permanent
}

# The development track. Same box and the same Caddy -- it owns 80 and 443, and
# both certificates renew in one place -- but different upstreams, reached over
# the external `alsigil-edge` network because staging is a separate compose
# project and Compose does not join projects together by default.
staging.alsigil.com {
	encode zstd gzip

	# Keeps the development copy out of search results. Without it the same
	# content is indexed twice under two hostnames, and the copy with sample
	# client data and a dev-instance banner is the one that can rank.
	header X-Robots-Tag "noindex, nofollow"

	# /api/* is deliberately NOT behind the password, and this is not an
	# oversight -- it was, for about an hour on 31 August 2026, and staging was
	# unusable because of it.
	#
	# `Authorization` is a single header. Once the browser holds basic
	# credentials for this origin it sends `Authorization: Basic ...`, and the
	# app needs to send `Authorization: Bearer <clerk session>` on the same
	# request. They cannot both be there. Measured through this proxy: with the
	# Basic header the request reaches the API, which finds no bearer token and
	# answers 403; with the Bearer header Caddy itself answers 401. Signing in
	# was structurally impossible, in both directions.
	#
	# What protects these routes instead is the API's own authentication: every
	# route requires a valid Clerk session, and staging's Clerk development
	# instance should have its sign-up restricted to our own addresses
	# (Clerk dashboard -> Restrictions -> allowlist). The password below still
	# keeps the interface itself away from crawlers and passers-by.
	handle /api/* {
		reverse_proxy api-staging:8000 {
			lb_try_duration 15s
			lb_try_interval 500ms
			flush_interval -1
		}
	}

	handle {
		# The password guards the interface. staging runs a Clerk development
		# instance and may run with LEGALOS_DEV_AUTH, which treats every caller
		# as one signed-in user, so this hostname should not be casually
		# openable by anyone who guesses it.
		#
		# The hash is committed on purpose, and is safe to: bcrypt cost 14 over
		# a 28-character random password that exists nowhere in this repository.
		# Rotate by generating a new pair with `caddy hash-password` and
		# replacing this line -- the plaintext belongs in a password manager.
		basic_auth {
			alsigil $2a$14$t7EFqZF/uEXvgOUesGXPNecZ2KIQydwHaA5XbDhadMdp7vlknYWp2
		}

		reverse_proxy web-staging:3000 {
			lb_try_duration 15s
			lb_try_interval 500ms
		}
	}

	log {
		output stdout
		format console
	}
}
