OPENROUTER_API_KEY=
POSTGRES_USER=legalrag
POSTGRES_PASSWORD=legalrag
POSTGRES_DB=legalrag
DATABASE_URL=postgresql://legalrag_app:legalrag_app@localhost:5432/legalrag
# Only if 5432 is already taken by another Postgres on this machine. Move both
# this and the port in DATABASE_URL together, or they will disagree.
# POSTGRES_PORT=5433
NVIDIA_API_KEY=
CLERK_JWKS_URL=
CLERK_SECRET_KEY=
# Outbound email. OPTIONAL: leaving it blank does not break anything -- an
# invitation is still created, and the app hands the owner the link to pass on
# themselves rather than failing the request.
RESEND_API_KEY=

# Where the web app is reachable, used to build the links inside outbound
# email. Must be set in production: it defaults to the local dev origin, so an
# unset value mails out invitation links pointing at http://localhost:3000.
APP_BASE_URL=

# Push notifications, for the reminder sweep's second channel. A path to the
# Firebase service-account JSON, or the JSON itself. OPTIONAL: unset simply
# means the sweep does not push, which is correct for an install with no
# mobile app. Separate from FIREBASE_PROJECT_ID below, which only verifies
# incoming tokens and needs no secret.
FIREBASE_SERVICE_ACCOUNT=

# Identity for the consumer mobile app (mobile/), which signs in with Firebase
# rather than Clerk — it is a separate business with a separate customer base.
# The value is the Firebase project id, and it is checked as the `aud` claim on
# every ID token: every Firebase project's tokens are signed by the same Google
# keys, so this is what stops a token minted by somebody else's Firebase app
# being accepted here.
#
# Leave unset on an instance that serves only LegalOS. The consumer routes then
# return 503 for a Firebase token instead of the API failing to start.
FIREBASE_PROJECT_ID=

# Where uploaded matter documents are written. Defaults to data/documents.
LEGALOS_DOCUMENT_ROOT=

# LOCAL DEVELOPMENT ONLY. Set to a Clerk user id (or a seeded placeholder such
# as seed_ahmed_al_sayed) to skip JWT verification entirely and treat every
# request as that user. Lets the stack run before Clerk is configured. Leaving
# it unset is what keeps authentication on — MUST NOT be set in a deployment.
# The frontend needs the matching web/.env.local entry:
#   NEXT_PUBLIC_LEGALOS_DEV_AUTH=seed_ahmed_al_sayed
LEGALOS_DEV_AUTH=

# Note: the Next.js frontend (web/) needs its own web/.env.local with
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY (and CLERK_SECRET_KEY) — see web/.env.local.
# These backend vars above are consumed by the FastAPI app, not by web/.

# Comma-separated extra browser origins allowed to call the API, e.g. the
# deployed frontend: https://your-app.vercel.app
LEGALOS_CORS_ORIGINS=

# Ceiling on a single uploaded document, in bytes. Defaults to 25MB, sized for
# a scanned court bundle. Raise it for a firm that files large scan sets.
LEGALOS_MAX_UPLOAD_BYTES=

# Requests per minute per caller, counted in the API (not at Caddy -- see
# src/legalrag/ratelimit.py for why). Two tiers because the costs differ:
# `PAID` covers the routes that call an LLM or embedding provider and so cost
# money per request; `NORMAL` covers everything else. Defaults: 30 and 300.
LEGALOS_RATE_LIMIT_PAID=
LEGALOS_RATE_LIMIT_NORMAL=
